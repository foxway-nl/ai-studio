# === AI-Studio Omgevingsvariabelen ===

# Poorten
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Google Gemini API
GEMINI_API_KEY=

# Ollama (lokale LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Stable Diffusion WebUI Forge
SD_WEBUI_BASE_URL=http://host.docker.internal:7860

# Google Cloud TTS (optioneel, als alternatief op Piper/Kokoro)
GOOGLE_TTS_API_KEY=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Piper TTS pad (in container)
PIPER_MODEL_PATH=/data/piper-models

# Kokoro TTS (optioneel)
KOKORO_BASE_URL=http://host.docker.internal:8080

# App configuratie
APP_SECRET_KEY=change-me-to-a-random-string
LOG_LEVEL=INFO

